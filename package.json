{
  "name": "remona",
  "productName": "reMona",
  "version": "1.0.0",
  "description": "reMona (AICleaner) — AI-assisted disk cleaner for Windows, built with Electron",
  "main": "electron/main.js",
  "author": "reMona",
  "license": "MIT",
  "private": true,
  "keywords": [
    "windows",
    "disk-cleaner",
    "cleaner",
    "electron",
    "ai",
    "openai",
    "system-utility",
    "storage",
    "multilingual"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "check": "npm run i18n:audit && npm run ui:audit",
    "i18n:audit": "node scripts/i18n-audit.js",
    "ui:audit": "node scripts/ui-audit.js",
    "smoke": "node scripts/smoke.js",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.remona.aicleaner",
    "productName": "reMona",
    "copyright": "Copyright © 2026 reMona (AICleaner) contributors",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "reMona AICleaner",
      "artifactName": "reMona-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "reMona-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
